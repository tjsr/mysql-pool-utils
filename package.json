{
  "name": "@tjsr/mysql-pool-utils",
  "version": "0.2.2",
  "description": "Connection handling and pooling utils for MySQL",
  "main": "dist/esm/mysqlUtils.js",
  "module": "dist/esm/mysqlUtils.js",
  "types": "dist/esm/mysqlUtils.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/mysqlUtils.d.ts",
        "default": "./dist/esm/mysqlUtils.js"
      },
      "require": {
        "types": "./dist/cjs/mysqlUtils.d.ts",
        "default": "./dist/cjs/mysqlUtils.js"
      }
    }
  },
  "scripts": {
    "build": "npm run build:dist",
    "build:dev": "linkteam && tsc -w",
    "build:dist": "rimraf dist && tsc -p tsconfig.publish.json && tsc -p tsconfig.cjs.json && node scripts/finalize-package.cjs",
    "check": "npx npm-check",
    "clean": "rimraf build dist coverage",
    "clean:all": "rimraf build dist coverage node_modules",
    "link": "linkteam",
    "lint": "node --require ./scripts/eslint-typescript-compat.cjs ./node_modules/eslint/bin/eslint.js --config eslint.config.mjs src/*.ts",
    "lint:fix": "eslint --config eslint.config.mjs --fix src/*.ts",
    "prepack": "npm run lint && npm test && npm run build && npm run test:package",
    "prepublishOnly": "npm run clean && npm test && npm run build",
    "db:up": "docker compose build && docker compose up -d",
    "db:down": "docker compose down",
    "disable:postinstall": "npm link @tjsr/simple-env-utils",
    "test": "wait-on tcp:127.0.0.1:23306 -t 20s && vitest --run && npm run lint",
    "test:package": "node scripts/test-package.cjs"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "package.json"
    ],
    "ext": "ts",
    "ignore": [
      "dist",
      "vitest.config.*"
    ],
    "exec": "tsc && tsc -p tsconfig.cjs.json",
    "delay": 200
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsr/mysql-pool-utils.git"
  },
  "keywords": [
    "env"
  ],
  "author": "Tim Rowe <tim@tjsr.id.au>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tjsr/mysql-pool-utils/issues"
  },
  "homepage": "https://github.com/tjsr/mysql-pool-utils#readme",
  "devDependencies": {
    "@tjsr/eslint-config": "github:tjsr/eslint-config#main",
    "@tjsr/testutils": "^0.0.11",
    "@types/node": "^24.19.2",
    "globals": "^17.14.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@tjsr/simple-env-utils": "^0.1.11",
    "mysql2": "^3.24.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "optionalDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=12.1.0"
  },
  "files": [
    "dist"
  ]
}
